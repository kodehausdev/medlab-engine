# ── AI ────────────────────────────────────────────────────────
# Dev/sandbox path: AI Studio API key (aistudio.google.com/apikey). No BAA —
# never point real patient traffic at this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini Live model for the streaming voice bridge (beta path — API key only)
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Production / BAA path: Vertex AI. No API key and no key file — auth is
# Application Default Credentials:
#   local dev:  gcloud auth application-default login
#   deployed:   attach the service account to the runtime (Cloud Run/GCE)
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── Persistence (leave blank to run on the in-memory store) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Twilio ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional outbound-SMS fallback From. Normally unneeded: SMS replies go out
# from the tenant number the patient texted (the inbound To).
TWILIO_SMS_NUMBER=
# Public HTTPS base URL (ngrok/railway) — used to build TwiML callback URLs
PUBLIC_BASE_URL=https://your-app.example.com

# ── Emergency paging (services/notify.js) ────────────────────
# Optional: pages the tenant's notify_email/notify_sms_number (set in the
# console's Settings) when the emergency gate fires. SMS paging reuses the
# Twilio config above — no separate credential needed. Leave blank to skip
# email paging (SMS still works if Twilio is configured).
RESEND_API_KEY=
EMERGENCY_ALERT_FROM_EMAIL=

# ── Appointment reminders + calendar invites (services/reminders.js,
#    services/calendarInvite.js) ────────────────────────────────────────
# Signs the .ics download link texted to patients. Leave blank to fall back
# to TWILIO_AUTH_TOKEN (already a private secret every deployed instance has).
CALENDAR_TOKEN_SECRET=
# Two-touch reminder schedule: day-before text + short same-day nudge, and
# how often the poller checks for appointments entering either window.
REMINDER_LEAD_HOURS=24
REMINDER_SAMEDAY_LEAD_HOURS=2
REMINDER_POLL_MINUTES=15

# ── Tenant (single-tenant MVP; multi-tenant lookup keyed by To number) ──
TENANT_ID=default
LAB_NAME=BrightPath Diagnostics
LAB_TIMEZONE=America/New_York
LAB_OPEN_HOUR=8
LAB_CLOSE_HOUR=17
SLOT_CAPACITY=2

PORT=3000
